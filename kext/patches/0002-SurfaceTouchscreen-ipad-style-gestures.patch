+// ---------------------------------------------------------------------------
+// SurfaceTouchMac: iPad-style single-finger touch
+// ---------------------------------------------------------------------------
+
+void SurfaceTouchscreenHIDEventDriver::loadGestureConfig() {
+    int dummy = 0;
+    if (PE_parse_boot_argn("-stmlegacytouch", &dummy, sizeof(dummy)))
+        stm_gestures = false;
+    stm::GestureConfig cfg;
+    UInt32 v = 0;
+    if (PE_parse_boot_argn("stmscrollinv", &v, sizeof(v)) && v)
+        cfg.scroll_sign = -1;
+    v = 0;
+    if (PE_parse_boot_argn("stmscrollspeed", &v, sizeof(v)) && v >= 25 && v <= 400)
+        cfg.scroll_um_per_pt = (stm::g_i32)(cfg.scroll_um_per_pt * 100 / v);   // percent
+    // Dock: stmdock=0 bottom (default), 1 left, 2 right, 3 off; stmdockzone=permille of the screen
+    v = 0;
+    if (PE_parse_boot_argn("stmdock", &v, sizeof(v)) && v <= 3)
+        cfg.dock_edge = (stm::g_i32)v;
+    v = 0;
+    if (PE_parse_boot_argn("stmdockzone", &v, sizeof(v)) && v >= 20 && v <= 250)
+        cfg.dock_zone_permille = (stm::g_i32)v;
+    gesture.setConfig(cfg);
+    IOLog("%s::SurfaceTouchMac gestures %s\n", getName(), stm_gestures ? "enabled" : "disabled (legacy touch)");
+}
+
+void SurfaceTouchscreenHIDEventDriver::dispatchGesture(AbsoluteTime timestamp, const stm::GestureEvent *ev, UInt32 count) {
+    using A = stm::GestureAction;
+    for (UInt32 i = 0; i < count; i++) {
+        const stm::GestureEvent &e = ev[i];
+        IOFixed x = e.x, y = e.y;
+        switch (e.action) {
+            case A::Move:
+                dispatchDigitizerEventWithTiltOrientation(timestamp, gesture_id, gesture_type, 0x1, 0x0, x, y);
+                break;
+            case A::LeftDown:
+            case A::DragMove:
+                dispatchDigitizerEventWithTiltOrientation(timestamp, gesture_id, gesture_type, 0x1, 0x1, x, y);
+                break;
+            case A::LeftUp:
+            case A::RightUp:
+                dispatchDigitizerEventWithTiltOrientation(timestamp, gesture_id, gesture_type, 0x1, 0x0, x, y);
+                break;
+            case A::RightDown:
+                dispatchDigitizerEventWithTiltOrientation(timestamp, gesture_id, gesture_type, 0x1, 0x2, x, y);
+                break;
+            case A::ScrollBegin:
+            case A::Scroll:
+            case A::ScrollEnd: {
+                IOOptionBits opt = kHIDDispatchOptionScrollNoAcceleration;
+                opt |= e.action == A::ScrollBegin ? kHIDDispatchOptionPhaseBegan
+                     : e.action == A::ScrollEnd   ? kHIDDispatchOptionPhaseEnded
+                                                  : kHIDDispatchOptionPhaseChanged;
+                // axis 1 = vertical, axis 2 = horizontal; values in points (16.16)
+                dispatchScrollWheelEventWithFixed(timestamp, (IOFixed)(e.dy * 65536), (IOFixed)(e.dx * 65536), 0, opt);
+                break;
+            }
+            default:
+                break;
+        }
+    }
+}
+
+void SurfaceTouchscreenHIDEventDriver::gestureRelease(AbsoluteTime timestamp, bool cancel) {
+    stm::GestureEvent out[stm::TouchGesture::kMaxOut];
+    UInt32 n;
+    if (cancel) {
+        n = gesture.cancel(out);
+    } else {
+        UInt64 ns;
+        absolutetime_to_nanoseconds(timestamp, &ns);
+        n = gesture.update(ns, false, gesture_x, gesture_y, out);
+    }
+    dispatchGesture(timestamp, out, n);
+}
+
+bool SurfaceTouchscreenHIDEventDriver::handleGestureFinger(AbsoluteTime timestamp, VoodooI2CMultitouchEvent event) {
+    for (int index = 0; index < event.transducers->getCount(); index++) {
+        VoodooI2CDigitiserTransducer* transducer = OSDynamicCast(VoodooI2CDigitiserTransducer, event.transducers->getObject(index));
+        if (!transducer || transducer->type != kDigitiserTransducerFinger)
+            continue;
+        UInt16 value = transducer->tip_switch.value();
+        UInt16 last_value = transducer->tip_switch.last.value;
+        if (!value && !last_value)
+            continue;
+        IOFixed x = ((transducer->coordinates.x.value() * 1.0f) / transducer->logical_max_x) * 65535;
+        IOFixed y = ((transducer->coordinates.y.value() * 1.0f) / transducer->logical_max_y) * 65535;
+        checkRotation(&x, &y);
+        gesture_id = transducer->secondary_id;
+        gesture_type = transducer->type;
+        gesture_x = x;
+        gesture_y = y;
+        UInt64 ns;
+        absolutetime_to_nanoseconds(timestamp, &ns);
+        stm::GestureEvent out[stm::TouchGesture::kMaxOut];
+        UInt32 n = gesture.update(ns, value != 0, x, y, out);
+        dispatchGesture(timestamp, out, n);
+        return true;
+    }
+    return false;
+}

+// ---------------------------------------------------------------------------
+// SurfaceTouchMac: in-kernel multitouch processing
+//
+// Stock BigSurface only switches the digitizer into multitouch (heatmap) mode
+// once the user-space IPTSDaemon connects, so the macOS installer, Setup
+// Assistant, Recovery and the login window only get single touch. With this
+// change the kext processes heatmaps itself from the moment it starts.
+// IPTSDaemon may still connect after boot; it then only supplies pen reports
+// (finger reports from the daemon are dropped so there are never two
+// competing finger translators producing duplicate clicks).
+//
+// Boot-args (OpenCore NVRAM, no rebuild needed):
+//   -stmnokproc        disable kernel processing (stock BigSurface behaviour)
+//   stmorient=<n>      bit0 invert X, bit1 invert Y, bit2 swap X/Y
+//   stmpalm=0          disable palm rejection
+//   stmpenblock=0      allow finger touches while the pen is in range
+// ---------------------------------------------------------------------------
+
+void IPTSKernelSink::onTouch(const stm::TouchFrame &f) {
+    if (driver) driver->kernelTouch(f);
+}
+
+void IPTSKernelSink::onStylus(const stm::StylusFrame &s) {
+    if (driver) driver->kernelStylus(s);
+}
+
+void IntelPreciseTouchStylusDriver::loadKernelProcessingConfig() {
+    int dummy = 0;
+    if (PE_parse_boot_argn("-stmnokproc", &dummy, sizeof(dummy)))
+        kernel_processing = false;
+    if (!kernel_processing)
+        return;
+    stm::ProcessorConfig cfg = stm::defaultConfig();
+    UInt32 orient = 0;
+    if (PE_parse_boot_argn("stmorient", &orient, sizeof(orient))) {
+        cfg.invert_x = orient & 0x1;
+        cfg.invert_y = orient & 0x2;
+        cfg.swap_xy  = orient & 0x4;
+    }
+    UInt32 flag = 1;
+    if (PE_parse_boot_argn("stmpalm", &flag, sizeof(flag)))
+        cfg.palm_rejection = flag != 0;
+    flag = 1;
+    if (PE_parse_boot_argn("stmpenblock", &flag, sizeof(flag)))
+        cfg.reject_touch_while_pen = flag != 0;
+    kproc->setConfig(cfg);
+}
+
+void IntelPreciseTouchStylusDriver::sendKernelReport(const IPTSHIDReport *report, UInt32 size) {
+    if (!kernel_report || !touch_screen || !touch_screen_started)
+        return;
+    kernel_report->setLength(size);
+    kernel_report->writeBytes(0, report, size);
+    touch_screen->handleReport(kernel_report);
+}
+
+void IntelPreciseTouchStylusDriver::kernelTouch(const stm::TouchFrame &f) {
+    IPTSHIDReport report;
+    memset(&report, 0, sizeof(report));
+    report.report_id = IPTS_TOUCH_REPORT_ID;
+    UInt8 n = f.count > IPTS_TOUCH_SCREEN_FINGER_CNT ? IPTS_TOUCH_SCREEN_FINGER_CNT : f.count;
+    for (UInt8 i = 0; i < n; i++) {
+        report.report.touch.fingers[i].touch = f.fingers[i].touch;
+        report.report.touch.fingers[i].contact_id = f.fingers[i].id;
+        report.report.touch.fingers[i].x = f.fingers[i].x;
+        report.report.touch.fingers[i].y = f.fingers[i].y;
+    }
+    report.report.touch.contact_num = n;
+    sendKernelReport(&report, sizeof(IPTSTouchHIDReport) + 1);
+}
+
+void IntelPreciseTouchStylusDriver::kernelStylus(const stm::StylusFrame &s) {
+    if (daemon_attached)    // daemon owns the pen while connected
+        return;
+    IPTSHIDReport report;
+    memset(&report, 0, sizeof(report));
+    report.report_id = IPTS_STYLUS_REPORT_ID;
+    report.report.stylus.in_range = s.in_range;
+    report.report.stylus.touch = s.touch;
+    report.report.stylus.side_button = s.touch && s.button;
+    report.report.stylus.inverted = s.rubber;
+    report.report.stylus.eraser = s.rubber;
+    report.report.stylus.x = s.x;
+    report.report.stylus.y = s.y;
+    report.report.stylus.tip_pressure = s.pressure;
+    report.report.stylus.scan_time = s.timestamp;
+    sendKernelReport(&report, sizeof(IPTSStylusHIDReport) + 1);
+}
+
+void IntelPreciseTouchStylusDriver::setDeviceMultitouch(bool enable) {
+    multitouch = enable;
+    if (status_interrupt)
+        status_interrupt->interruptOccurred(nullptr, this, 0);
+}

# Pinned upstream sources. Bump deliberately; CI records sha256 of everything.

# Surface Pro 7 OpenCore base (ACPI patches, config, kexts) - balopez83, LTS for Tahoe
BASE_EFI_REPO=balopez83/Surface-Pro-7-Hackintosh
BASE_EFI_TAG=2.5.0
# release asset EFI_OCmodr1.0.5_r2.5.0.7z ships config-i5.plist and config-i7.plist;
# this build targets the Surface Pro 7 i5-1035G4
BASE_CONFIG=config-i5.plist
BASE_EFI_ASSET_SHA256=89db5410531f974042cfc393d85969ac8b65efcdceb4557bc6b714dc81e3720a

# BigSurface (built from source with SurfaceTouchMac's kernel multitouch patch)
BIGSURFACE_REPO=Xiashangning/BigSurface
BIGSURFACE_COMMIT=8282631
BIGSURFACEHID_COMMIT=f1aab181c3050602780a7ef34b3a123928a4d53f
VOODOOGPIO_COMMIT=d9bf9fdd15c32004c21df6090cc58e868b279dab
VOODOOINPUT_COMMIT=6ce7ef35b3d2161733552377abcdbe7d84834c27
VOODOOSERIAL_COMMIT=71e459e2dae79593808dc968f7e4c8e5bbb56163

# Optional pen helper (handles DFT pen data; fingers stay in the kernel)
IPTSDAEMON_REPO=Xiashangning/IPTSDaemon
IPTSDAEMON_COMMIT=8e19309

# macOS: newest Tahoe (26.x) full installer from Apple's software update catalog
MACOS_MAJOR=26

# Wi-Fi on Tahoe: AirportItlwm from the laobamac fork (built from source).
# The base EFI only ships AirportItlwm up to Sonoma (Darwin 23).
ITLWM_REPO=laobamac/itlwm
ITLWM_COMMIT=738d4c61b5a64433b27c1ab09dba94916ab77d8d
ITLWM_MACKERNELSDK_COMMIT=3f750085caa17ec3a7880f11c11bf4f48cd6a164
